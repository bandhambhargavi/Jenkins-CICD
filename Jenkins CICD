pipeline {
    agent any // Runs this pipeline on any available Jenkins worker node

    stages {
        stage('Build') {
            steps {
                echo 'Building the application...'
                // Example: sh 'npm run build' or sh 'mvn clean package'
            }
        }
        
        stage('Test') {
            steps {
                echo 'Running automated tests...'
                // Example: sh 'npm test' or sh 'mvn test'
            }
        }
        
        stage('Deploy') {
            steps {
                echo 'Deploying application to server...'
                // Example: sh './deploy.sh'
            }
        }
    }
    
    post {
        always {
            echo 'Pipeline has finished execution.'
        }
        success {
            echo 'The build was successful! 🎉'
        }
        failure {
            echo 'The build failed. ❌'
        }
    }
}
